{
	"root": true,
	"$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"style": {
				"noNonNullAssertion": "error"
			},
			"preset": "recommended",
			"nursery": {},
			"correctness": {
				"noUnusedImports": "error"
			}
		}
	},
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"overrides": [
		{
			"includes": ["src/client/vue/**"],
			"linter": {
				"rules": {
					"style": { "useVueMultiWordComponentNames": "off" }
				}
			}
		},
		{
			"includes": ["**/*.svelte"],
			"linter": {
				"rules": {
					"style": { "useConst": "off", "useImportType": "off" },
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off",
						"useHookAtTopLevel": "off"
					}
				}
			}
		}
	],
	"files": {
		"includes": [
			"**",
			"!**/dist/**",
			"!**/coverage/**",
			"!**/target/**",
			"!**/examples/emails/**",
			"!**/*.html",
			"!**/index.js",
			"!**/index.d.ts",
			"!**/*_wasm.d.ts",
			"!**/tsconfig*.json",
			"!**/package.json",
			"!**/vitest.config.ts",
			"!**/scripts/**"
		]
	}
}
