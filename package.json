{
  "name": "@c9up/photon",
  "version": "0.1.7",
  "description": "Photon — Frontend rendering engine for the Ream framework",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/PhotonProvider.ts",
      "import": "./src/PhotonProvider.ts"
    },
    "./configure": {
      "types": "./src/configure.ts",
      "import": "./src/configure.ts"
    },
    "./client": {
      "types": "./src/client/hydrate.ts",
      "import": "./src/client/hydrate.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "biome check src/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@c9up/ream": "^0.1.0",
    "react": "*",
    "react-dom": "*",
    "vue": "*",
    "svelte": "*"
  },
  "peerDependenciesMeta": {
    "@c9up/ream": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@types/node": "^22.19.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^29.1.1",
    "react": "^19",
    "react-dom": "^19",
    "reflect-metadata": "^0.2.2",
    "svelte": "^5",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "vue": "^3"
  },
  "pnpm": {
    "//": "Pin the test toolchain to the versions used in dev. Without a committed lockfile the standalone CI resolves fresh (esbuild 0.28.x / vitest 4.1.9), whose decorator transform flakes 'Invalid or unexpected token' on the @Meta decorator suites. Overrides only apply when this package is the install root (CI), so the monorepo workspace is unaffected.",
    "overrides": {
      "esbuild": "0.27.7",
      "vite": "7.3.3",
      "vitest": "4.1.6"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./provider": {
        "types": "./dist/PhotonProvider.d.ts",
        "import": "./dist/PhotonProvider.js"
      },
      "./configure": {
        "types": "./dist/configure.d.ts",
        "import": "./dist/configure.js"
      },
      "./client": {
        "types": "./dist/client/hydrate.d.ts",
        "import": "./dist/client/hydrate.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/photon.git"
  }
}
