{
  "name": "@c9up/photon",
  "version": "0.1.17",
  "description": "Photon — Frontend rendering engine for the Ream framework",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./provider": {
      "types": "./src/PhotonProvider.ts",
      "import": "./src/PhotonProvider.ts"
    },
    "./configure": {
      "types": "./src/configure.ts",
      "import": "./src/configure.ts"
    },
    "./client": {
      "types": "./src/client/hydrate.ts",
      "import": "./src/client/hydrate.ts"
    }
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "lint": "biome check src/ tests/",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@c9up/ream": "^0.2.0",
    "react": ">=18",
    "react-dom": ">=18",
    "svelte": ">=5",
    "vite": ">=5",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "@c9up/ream": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@c9up/ream": "^0.2.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reflect-metadata": "^0.2.2",
    "svelte": "^5.57.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "4.1.11",
    "vue": "^3.5.42"
  },
  "pnpm": {
    "//": "Pin the test toolchain to the versions used in dev. Without a committed lockfile the standalone CI resolves fresh (esbuild 0.28.x / vitest 4.1.9), whose decorator transform flakes 'Invalid or unexpected token' on the @Meta decorator suites. Overrides only apply when this package is the install root (CI), so the monorepo workspace is unaffected.",
    "overrides": {
      "esbuild": "0.27.7",
      "vite": "7.3.3",
      "vitest": "4.1.6"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./provider": {
        "types": "./dist/PhotonProvider.d.ts",
        "import": "./dist/PhotonProvider.js"
      },
      "./configure": {
        "types": "./dist/configure.d.ts",
        "import": "./dist/configure.js"
      },
      "./client": {
        "types": "./dist/client/hydrate.d.ts",
        "import": "./dist/client/hydrate.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C9up/photon.git"
  }
}
